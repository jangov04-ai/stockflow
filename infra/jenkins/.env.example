# Copia este fichero como .env y rellena los valores. .env NO se sube a git.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambia-esta-clave

# GitHub: token fine-grained con acceso a los repos y permisos
#   Contents: Read-only  +  Commit statuses: Read and write
