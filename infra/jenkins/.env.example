GITHUB_TOKEN=PEGA_AQUI_TU_TOKEN
GITHUB_REPO_URL=https://github.com/jangov04-ai/jenkins-pipeline-ci-.git
STOCKFLOW_REPO_URL=https://github.com/jangov04-ai/stockflow.git

# Correo (Gmail, contraseña de aplicación)
GMAIL_USER=jangov04@gmail.com
GMAIL_APP_PASSWORD=PEGA_AQUI_LA_CONTRASEÑA_DE_APLICACION
NOTIFY_EMAIL=jangov04@gmail.com

# SonarQube (http://localhost:9000)
SONAR_ADMIN_PASSWORD=cambia-esta-clave
SONAR_TOKEN=se-genera-tras-arrancar-sonarqube
